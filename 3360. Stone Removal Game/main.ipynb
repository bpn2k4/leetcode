      "source": [
        "class Solution:\n",
        "  def canAliceWin(self, n: int) -> bool:\n",
        "    alice_win = False\n",
        "    k = 10\n",
        "    while n >= k:\n",
        "      n -= k\n",
        "      k -= 1\n",
        "      alice_win = not alice_win\n",
        "    return alice_win"
      ]
    },
    {
