      "source": [
        "class Solution:\n",
        "  def reverseDegree(self, s: str) -> int:\n",
        "    p = 0\n",
        "    for index, char in enumerate(s, start=1):\n",
        "      p += index * (26 - ord(char) + ord('a'))\n",
        "    return p"
      ]
    },
